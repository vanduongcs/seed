# ======================
# SERVER
# ======================
PORT=3000
NODE_ENV=development

# ======================
# DATABASE
# ======================
MONGODB_URI=mongodb://localhost:27017/seed_db

# ======================
# JWT
# ======================
JWT_ACCESS_SECRET=seed-b2207577-thuctapkhmtctu-access
JWT_REFRESH_SECRET=seed-b2207577-thuctapkhmtctu-refresh
JWT_LEGACY_ACCESS_SECRETS=
JWT_LEGACY_REFRESH_SECRETS=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ======================
# AI
# ======================
OPENAI_API_KEY=
GEMINI_API_KEY=
AI_PROVIDER=openai   # openai | gemini | ollama
OLLAMA_BASE_URL=http://localhost:11434

# ======================
# CORS
# ======================
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ======================
# RATE LIMITING
# ======================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ======================
# GRAIN IMAGE WORKER
# ======================
GRAIN_PROCESS_TIMEOUT_MS=180000
GRAIN_PYTHON_BIN=
# surface_quality | surface_pile | balanced | dense_fast | seed_fast | sam_instances
GRAIN_PROCESS_PROFILE=surface_quality
# Optional JSON object to override backend grain defaults without changing UI/client code.
# Example: {"maskSource":"hybrid","maxSide":1800,"splitSensitivity":7}
# The default profile auto-detects image context first, then tunes dense-pile marker/peak settings.
# Set {"autoImageProfile":false,"autoSurfaceTune":false} only for reproducible fixed-parameter tests.
GRAIN_DEFAULT_PARAMS_JSON=
