# ======================
# SERVER
# ======================
PORT=3000
NODE_ENV=development

# ======================
# DATABASE
# ======================
MONGODB_URI=mongodb://localhost:27017/seed_db

# ======================
# JWT
# ======================
JWT_ACCESS_SECRET=your_access_secret_here
JWT_REFRESH_SECRET=your_refresh_secret_here
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ======================
# AI
# ======================
OPENAI_API_KEY=your_openai_key_here
GEMINI_API_KEY=your_gemini_key_here
AI_PROVIDER=openai   # openai | gemini | ollama
OLLAMA_BASE_URL=http://localhost:11434

# ======================
# CORS
# ======================
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ======================
# RATE LIMITING
# ======================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ======================
# GRAIN IMAGE WORKER
# ======================
GRAIN_PROCESS_TIMEOUT_MS=180000
GRAIN_PYTHON_BIN=
# Optional JSON object to override backend grain defaults without changing UI/client code.
# Example: {"maskSource":"hybrid","maxSide":1800,"splitSensitivity":7}
GRAIN_DEFAULT_PARAMS_JSON=
