{
  "pipeline": "yolo8_nano_segment",
  "params": {
    "pipeline":               { "type": "string",  "default": "yolo8_nano_segment" },
    "maxSide":                { "type": "number",  "default": 1024,   "min": 128,  "max": 4096 },

    "yoloModelPath":          { "type": "string",  "default": "auto", "env": "GRAIN_YOLO_MODEL" },
    "yoloConf":               { "type": "number",  "default": 0.05,   "min": 0.01, "max": 0.99 },
    "yoloIou":                { "type": "number",  "default": 0.55,   "min": 0.05, "max": 0.95 },
    "yoloImgSize":            { "type": "number",  "default": 1024,   "min": 160,  "max": 2048 },
    "yoloMaxDet":             { "type": "number",  "default": 5000,   "min": 1,    "max": 5000 },

    "enableTiledInference":   { "type": "boolean", "default": false },
    "enableFullImagePass":    { "type": "boolean", "default": true },
    "tileSize":               { "type": "number",  "default": 1024,   "min": 160,  "max": 2048 },
    "tileOverlap":            { "type": "number",  "default": 0.20,   "min": 0,    "max": 0.8 },
    "enableTinyTilePass":     { "type": "boolean", "default": false },
    "tinyTileSize":           { "type": "number",  "default": 320,    "min": 160,  "max": 1024 },
    "mergeIou":               { "type": "number",  "default": 0.35,   "min": 0.05, "max": 0.95 },
    "mergeOverlap":           { "type": "number",  "default": 0.70,   "min": 0.05, "max": 1.0 },
    "edgeMarginRatio":        { "type": "number",  "default": 0.1,    "min": 0,    "max": 0.4 },

    "samEncoderModel":        { "type": "string",  "default": "mobile_sam_encoder.onnx", "env": "GRAIN_SAM_ENCODER_MODEL" },
    "samModel":               { "type": "string",  "default": "mobile_sam_decoder.onnx", "env": "GRAIN_SAM_MODEL" },
    "enableSamRefine":        { "type": "boolean", "default": false },
    "samCandidateLimit":      { "type": "number",  "default": 80,     "min": 1,    "max": 5000 },
    "samImgSize":             { "type": "number",  "default": 1024,   "min": 320,  "max": 2048 },
    "samMaxDet":              { "type": "number",  "default": 1000,   "min": 1,    "max": 5000 },
    "samConf":                { "type": "number",  "default": 0.25,   "min": 0.01, "max": 0.99 },
    "samIou":                 { "type": "number",  "default": 0.9,    "min": 0.05, "max": 0.99 },
    "samBoxPadding":          { "type": "number",  "default": 8,      "min": 0,    "max": 128 },

    "enableGrabCut":          { "type": "boolean", "default": false },
    "grabCutIter":            { "type": "number",  "default": 3,      "min": 1,    "max": 10 },
    "enableEdgeSnap":         { "type": "boolean", "default": false },
    "edgeSnapRadius":         { "type": "number",  "default": 6,      "min": 1,    "max": 20 },
    "edgeSnapSigma":          { "type": "number",  "default": 1.5,    "min": 0.5,  "max": 5.0 },
    "maskContourSmooth":      { "type": "number",  "default": 1.0,    "min": 0,    "max": 5 },

    "preprocessImage":        { "type": "boolean", "default": false },
    "whiteBalanceStrength":   { "type": "number",  "default": 0.25,   "min": 0,    "max": 1 },
    "claheClipLimit":         { "type": "number",  "default": 2.5,    "min": 0,    "max": 6 },
    "claheTileSize":          { "type": "number",  "default": 5,      "min": 2,    "max": 32 },
    "denoiseStrength":        { "type": "number",  "default": 0.1,    "min": 0,    "max": 1 },
    "denoiseDiameter":        { "type": "number",  "default": 5,      "min": 3,    "max": 15 },

    "minArea":                { "type": "number",  "default": 20,     "min": 1,    "max": 1000000 },
    "maxArea":                { "type": "number",  "default": 200000, "min": 1,    "max": 100000000 },
    "maxSegmentAspectRatio":  { "type": "number",  "default": 14,     "min": 1,    "max": 200 },
    "minSegmentSolidity":     { "type": "number",  "default": 0.5,    "min": 0,    "max": 1 },
    "minSegmentExtent":       { "type": "number",  "default": 0.2,    "min": 0,    "max": 1 },

    "referencePixels":        { "type": "number",  "default": 0,      "min": 0,    "max": 1000000 },
    "referenceMm":            { "type": "number",  "default": 0,      "min": 0,    "max": 1000000 },
    "referencePixelSpace":    { "type": "string",  "default": "original" },
    "referenceX1":            { "type": "number",  "default": -1,     "min": -1,   "max": 1000000 },
    "referenceY1":            { "type": "number",  "default": -1,     "min": -1,   "max": 1000000 },
    "referenceX2":            { "type": "number",  "default": -1,     "min": -1,   "max": 1000000 },
    "referenceY2":            { "type": "number",  "default": -1,     "min": -1,   "max": 1000000 }
  },
  "csvColumns": [
    "id", "area_px", "length_px", "width_px",
    "area_mm2", "length_mm", "width_mm",
    "centroid_x", "centroid_y",
    "bbox_x", "bbox_y", "bbox_w", "bbox_h",
    "angle_deg", "solidity", "extent", "aspect_ratio",
    "confidence", "class_id", "class_name", "qc_outlier", "qc_reason"
  ],
  "palette": [
    [45,  108, 191],
    [219,  87,  86],
    [73,  160, 120],
    [235, 174,  73],
    [132,  98, 174],
    [77,  176, 196],
    [201, 112, 165],
    [122, 126, 135]
  ]
}
