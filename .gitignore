# Keep old/export experiment models local.
backend/model/previous_model/
mobile/assets/models/best_1024_yolo26.onnx
mobile/assets/models/best_mobile_stable.onnx

# Azure/server builds require the same production model in source artifacts.
!backend/model/main_model/best.onnx
